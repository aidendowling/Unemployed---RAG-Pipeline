# Copy this file to .env and fill in your local values.
# Keep .env out of version control.

# OpenRouter / generation settings
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ingestion settings
RAW_DATA_DIR=data/raw
DUCKDB_PATH=data/processed/unemployed_rag.duckdb

# Retrieval/indexing settings
INDEX_DIR=data/indexes
CHROMA_COLLECTION_NAME=labor_market
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Hybrid retrieval settings
HYBRID_FUSION_METHOD=rrf
HYBRID_RRF_K=60
HYBRID_SEMANTIC_WEIGHT=0.5

# Knowledge-obsolescence thresholds
MIN_VINTAGE_SCORE=0.1
VINTAGE_WARN_SCORE=0.6

# Evaluation settings
EVAL_DIR=data/eval

# Optional app metadata
APP_NAME=Unemployed RAG Pipeline
LOG_LEVEL=INFO

# Data provider credentials
FRED_API_KEY=YOUR_FRED_API_KEY_HERE
FRED_BASE_URL=https://api.stlouisfed.org/fred

# https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=YOUR_CENSUS_API_KEY_HERE
QWI_BASE_URL=https://api.census.gov/data/timeseries/qwi

# Optional: default layout for CPS .dat extracts (IPUMS .xml DDI, JSON, or .txt dictionary)
# CPS_LAYOUT_PATH=data/raw/cps_00001.xml