  "fields": [
    {"name": "HRHHID", "start": 1, "end": 15, "dtype": "string", "description": "Household identifier"},
    {"name": "HRMONTH", "start": 16, "end": 17, "dtype": "int", "description": "Month of interview"},
    {"name": "HRYEAR4", "start": 18, "end": 21, "dtype": "int", "description": "Year of interview (4 digit)"},
    {"name": "HURESPLI", "start": 22, "end": 23, "dtype": "int", "description": "Line number of household respondent"},
    {"name": "HUFINAL", "start": 24, "end": 26, "dtype": "int", "description": "Final outcome code"},
    {"name": "HETENURE", "start": 29, "end": 30, "dtype": "int", "description": "Housing tenure"},
    {"name": "HEHOUSUT", "start": 31, "end": 32, "dtype": "int", "description": "Type of housing unit"},
    {"name": "HEFAMINC", "start": 39, "end": 40, "dtype": "int", "description": "Family income range"},
    {"name": "HWHHWGT", "start": 47, "end": 56, "dtype": "weight", "description": "Household weight (4 implied decimals)"},
    {"name": "HRNUMHOU", "start": 59, "end": 60, "dtype": "int", "description": "Total persons in household"},
    {"name": "HRHTYPE", "start": 61, "end": 62, "dtype": "int", "description": "Household type"},
    {"name": "HRMIS", "start": 63, "end": 64, "dtype": "int", "description": "Month in sample"},
